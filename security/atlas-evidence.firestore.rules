rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function role(workspace) {
      return get(/databases/$(database)/documents/workspaces/$(workspace)/members/$(request.auth.uid)).data.role;
    }
    function reader(workspace) {
      return verified() && role(workspace) in ['viewer', 'editor', 'reviewer'];
    }
    function editor(workspace) {
      return verified() && role(workspace) == 'editor';
    }
    function reviewer(workspace) {
      return verified() && role(workspace) == 'reviewer';
    }
    function evidencePath(workspace, key, factId) {
      return /databases/$(database)/documents/workspaces/$(workspace)/agencies/$(key)/evidence/$(factId);
    }
    function decisionPath(workspace, key, factId, action) {
      return /databases/$(database)/documents/workspaces/$(workspace)/agencies/$(key)/evidence/$(factId)/decisions/$(action);
    }
    function blockedAfter(workspace, key, factId) {
      return existsAfter(decisionPath(workspace,key,factId,'challenged'))
        || existsAfter(decisionPath(workspace,key,factId,'withdrawn'))
        || existsAfter(decisionPath(workspace,key,factId,'superseded'));
    }
    function matchingReplacement(workspace,key,factId,replacementId) {
      let original = get(evidencePath(workspace,key,factId)).data;
      let replacement = get(evidencePath(workspace,key,replacementId)).data;
      return replacementId != factId
        && replacement.kind == original.kind && replacement.stateCode == original.stateCode
        && replacement.agencyKey == key && replacement.factId == replacementId
        && (!(original.kind in ['procurement-open','procurement-awarded','procurement-closed','contract-expiration','grant-awarded','capital-approved'])
          || (replacement.sourceName == original.sourceName && replacement.sourceRecordId == original.sourceRecordId))
        && exists(decisionPath(workspace,key,replacementId,'approved'))
        && !blockedAfter(workspace,key,replacementId);
    }
    function validDecision(workspace,key,factId,action) {
      let d = request.resource.data;
      let original = get(evidencePath(workspace,key,factId)).data;
      return d.keys().hasAll(['action','reason','replacementId','factId','reviewerUid','reviewedAt'])
        && d.keys().hasOnly(['action','reason','replacementId','factId','reviewerUid','reviewedAt'])
        && original.factId == factId && original.agencyKey == key
        && d.factId == factId && d.action == action
        && d.reviewerUid == request.auth.uid && d.reviewedAt == request.time
        && (
          (action == 'approved' && d.reason == 'source-checked' && d.replacementId == ''
            && original.authorUid != request.auth.uid && !blockedAfter(workspace,key,factId))
          || (action == 'challenged' && d.reason in ['source-conflict','identity-mismatch','scope-unclear','outdated','incorrect-value','unreliable-source'] && d.replacementId == '')
          || (action == 'withdrawn' && d.reason in ['source-retracted','incorrect-value','privacy-concern','unreliable-source'] && d.replacementId == '')
          || (action == 'superseded' && d.reason == 'corrected-evidence'
            && d.replacementId is string && d.replacementId.matches('^[A-Za-z0-9_-]{1,100}$')
            && matchingReplacement(workspace,key,factId,d.replacementId))
        );
    }
    function text(v, max) { return v is string && v.trim().size() > 0 && v.size() <= max; }
    function day(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function validKey(key, state) {
      return key.matches('^NPI:[0-9]{10}$') || key.matches('^NERIS:[A-Z0-9.-]{1,80}$')
        || key.matches('^FDID:' + state + ':[A-Z0-9.-]{1,80}$')
        || key.matches('^STATE-EMS:' + state + ':(agency-code|license):[A-Z0-9.-]{1,80}$');
    }
    function validEntry(key, factId) {
      let d = request.resource.data;
      return d.keys().hasAll(['agencyKey','agencyName','stateCode','factId','kind','value','sourceName','sourceRecordId','sourceUrl','documentDate','dueDate','enteredAt','authorUid','publishedAt'])
        && d.keys().hasOnly(['agencyKey','agencyName','stateCode','factId','kind','value','sourceName','sourceRecordId','sourceUrl','documentDate','dueDate','enteredAt','authorUid','publishedAt'])
        && d.agencyKey == key && d.factId == factId && factId.matches('^[A-Za-z0-9_-]{1,100}$')
        && d.stateCode is string && d.stateCode.matches('^[A-Z]{2}$') && validKey(key, d.stateCode)
        && text(d.agencyName,240) && text(d.value,500) && text(d.sourceName,160) && text(d.sourceRecordId,160)
        && text(d.sourceUrl,2048) && d.sourceUrl.matches('^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/|[?])[^ ]+$')
        && d.kind in ['installed-monitor','installed-cpr','installed-ventilator','installed-epcr','installed-cad','installed-billing','contract-expiration','procurement-open','procurement-awarded','procurement-closed','grant-awarded','capital-approved']
        && day(d.documentDate) && text(d.enteredAt,40)
        && d.enteredAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$')
        && day(d.enteredAt[0:10]) && d.documentDate <= d.enteredAt[0:10]
        && ((d.kind == 'procurement-open' && day(d.dueDate) && d.dueDate >= d.documentDate) || (d.kind != 'procurement-open' && d.dueDate == ''))
        && (d.kind != 'contract-expiration' || (day(d.value) && d.value >= d.documentDate))
        && d.authorUid == request.auth.uid && d.publishedAt == request.time;
    }
    match /workspaces/{workspace}/members/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /workspaces/{workspace}/agencies/{key}/evidence/{factId} {
      allow get: if reader(workspace);
      allow list: if reader(workspace) && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 50;
      allow create: if editor(workspace) && validEntry(key, factId);
      allow update, delete: if false;
    }
    match /workspaces/{workspace}/agencies/{key}/evidence/{factId}/decisions/{action} {
      allow get: if reader(workspace);
      allow list: if reader(workspace) && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 5;
      allow create: if reviewer(workspace) && validDecision(workspace,key,factId,action);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
